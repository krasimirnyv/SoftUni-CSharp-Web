@{
    ViewData["Title"] = "Bad Request";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="text-center">
        <!-- Error Icon -->
        <div class="mb-4">
            <i class="bi bi-exclamation-triangle-fill" style="font-size: 6rem; color: #ff4d4d;"></i>
        </div>

        <!-- Error Code -->
        <h1 class="display-1 fw-bold text-danger mb-3" style="font-size: 5rem; text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);">
            400
        </h1>

        <!-- Error Title -->
        <h2 class="text-light fw-bold mb-3" style="font-size: 2.5rem; text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);">
            Bad Request
        </h2>

        <!-- Error Description -->
        <p class="text-light lead mb-4" style="font-size: 1.2rem; max-width: 600px; margin-left: auto; margin-right: auto;">
            Oops! It looks like your request couldn't be processed. The server couldn't understand what you were asking for. 
            Please check your input and try again.
        </p>

        <!-- Error Details Card -->
        <div class="card bg-secondary border-0 rounded-3 shadow-lg mb-4" style="max-width: 500px; margin-left: auto; margin-right: auto;">
            <div class="card-body p-4">
                <h5 class="card-title text-warning fw-bold mb-3">
                    <i class="bi bi-info-circle"></i> What might have gone wrong?
                </h5>
                <ul class="text-start text-light small" style="line-height: 2;">
                    <li>Invalid or malformed request parameters</li>
                    <li>Missing required fields in your submission</li>
                    <li>Invalid data format or encoding</li>
                    <li>Request body too large</li>
                </ul>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex gap-3 justify-content-center mb-4 flex-wrap">
            <a href="/" class="btn btn-danger fw-bold rounded-pill px-4 py-2 shadow-sm" style="background: #ff4d4d; border: none;">
                <i class="bi bi-house-fill"></i> Go to Home
            </a>
            <button onclick="history.back()" class="btn btn-outline-light fw-bold rounded-pill px-4 py-2 shadow-sm">
                <i class="bi bi-arrow-left"></i> Go Back
            </button>
        </div>

        <!-- Additional Help -->
        <p class="text-muted small mt-4">
            <i class="bi bi-question-circle"></i> Still having issues? 
            <a href="/" class="text-warning text-decoration-none fw-bold">Contact support</a> or 
            <a href="/" class="text-warning text-decoration-none fw-bold">visit our help center</a>
        </p>
    </div>
</div>
