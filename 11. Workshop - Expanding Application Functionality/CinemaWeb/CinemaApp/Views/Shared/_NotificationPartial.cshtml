@using static CinemaApp.GCommon.ApplicationConstants

@if (TempData[ErrorTempDateKey] != null)
{
    <script>toastr.error("@TempData[ErrorTempDateKey]")</script>
}
else if (TempData[WarningTempDataKey] != null)
{
    <script>toastr.warning("@TempData[WarningTempDataKey]")</script>
}
else if (TempData[InfoTempDataKey] != null)
{
    <script>toastr.info("@TempData[InfoTempDataKey]")</script>
}
else if (TempData[SuccessTempDataKey] != null)
{
    <script>toastr.success("@TempData[SuccessTempDataKey]")</script>
}