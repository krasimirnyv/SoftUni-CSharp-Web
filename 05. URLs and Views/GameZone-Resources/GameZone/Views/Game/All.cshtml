@model IEnumerable<GameViewModel>

@{
    ViewBag.Title = "Hall of Games";
}

<h2 class="text-center">@ViewBag.Title</h2>
<hr />

<div class="text-center row">
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <strong>@TempData["SuccessMessage"]</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @foreach (GameViewModel game in Model)
    {
        <div class="card col-3 h-100" style="width: 20rem; ">
            @if (!string.IsNullOrEmpty(game.ImageUrl))
            {
                <img src="@game.ImageUrl" class="card-img-top img-fluid" style="height: 200px; object-fit: cover;" alt="Game Image">
            }
            else
            {
                <img src="~/img/PH.jpg" class="card-img-top img-fluid" style="height: 200px; object-fit: cover;" alt="Placeholder Image">
            }

            <div class="card-body" style="height: calc(100% - 150px); overflow: auto;">
                <div class="row">
                    <div class="col-12">
                        <div class="title-wrapper" style="height: 6em; overflow: hidden;">
                            <h4 class="card-title mt-1">@game.Title</h4>
                        </div>
                    </div>
                </div>

                <h5 class="card-title mt-1">@game.Genre</h5>
                <p class="mb-0"><span class="fw-bold">Released On: </span>@game.ReleasedOn</p>
                <p class="mb-0"><span class="fw-bold">Publisher: </span>@game.PublisherName</p>
            </div>

            <div class="row gx-0">
                <div class="col-12 px-1">
                    <a asp-controller="Game" asp-action="Details" asp-route-id="@game.Id"
                       class="btn btn-warning btn-sm mb-2 w-100 fw-bold rounded btn-dark-text">Details</a>
                </div>
            </div>

            <div class="row gx-0">
                <div class="col-6 px-1">
                    <a asp-controller="Game" asp-action="Edit" asp-route-id="@game.Id"
                       class="btn btn-warning btn-sm mb-2 w-100 fw-bold rounded btn-dark-text">Edit</a>
                </div>
                <div class="col-6 px-1">
                    <a asp-controller="Game" asp-action="Delete" asp-route-id="@game.Id"
                       class="btn btn-warning btn-sm mb-2 w-100 fw-bold rounded btn-dark-text">Delete</a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        // Dismiss alert automatically after 5 seconds
        setTimeout(function() {
            var alert = document.querySelector('.alert');
            if (alert) {
                var bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            }
        }, 5000);
    </script>
}