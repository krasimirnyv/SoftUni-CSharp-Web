@model GameDeleteViewModel

@{
    ViewBag.Title = "Last Hall";
}

<h2 class="text-center">@ViewBag.Title</h2>
<hr />

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body text-center">
                <h3 class="card-title">@Model.Title</h3>

                <p class="text-danger mt-3">
                    Are you sure you want to delete <strong>@Model.Title</strong>?
                </p>
            </div>

            <div class="card-footer text-center">
                <form asp-controller="Game" asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />

                    <button type="submit" class="btn btn-danger me-2">
                        Confirm Delete
                    </button>

                    <a asp-controller="Game" asp-action="All" class="btn btn-secondary">
                        Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
