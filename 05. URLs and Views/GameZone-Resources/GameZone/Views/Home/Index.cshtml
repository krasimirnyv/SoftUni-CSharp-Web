@{
    ViewData["Title"] = "Home";
}

<div class="text-center mb-4">
    <h1 class="display-4 fw-bold">Welcome to <span class="text-warning">GameZone</span></h1>
    <p class="lead mb-3">A home for real gamers — discover classics, share legends, and build your hall of fame.</p>

    <img src="~/img/Picture1.png"
         alt="GameZone Play"
         class="img-fluid my-3"
         style="max-width: 260px; height: auto; display: block; margin-left: auto; margin-right: auto;
                filter: drop-shadow(0 0 12px rgba(0,255,255,0.35));" />

    <div class="d-flex justify-content-center gap-2 flex-wrap">
        <a class="btn btn-warning btn-dark-text fw-bold px-4 py-2 rounded"
           asp-controller="Game" asp-action="All">Enter the Hall of Games</a>

        <a class="btn btn-outline-light fw-bold px-4 py-2 rounded"
           asp-controller="Game" asp-action="Add">Blast a New Game</a>
    </div>
</div>


<div class="row g-4 align-items-stretch mt-4">
    <div class="col-lg-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h4 class="card-title fw-bold">What is GameZone?</h4>
                <p class="card-text mb-3">
                    GameZone is a community-driven place where every entry tells a story.
                    Add games you love, browse legendary titles, and keep the collection growing.
                </p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <h6 class="fw-bold mb-1">🎮 Discover</h6>
                            <p class="mb-0 small text-muted">Browse games by genre and release date.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <h6 class="fw-bold mb-1">🧠 Learn</h6>
                            <p class="mb-0 small text-muted">Read descriptions and details for each title.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <h6 class="fw-bold mb-1">🚀 Contribute</h6>
                            <p class="mb-0 small text-muted">Add new games with title, genre and release date.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <h6 class="fw-bold mb-1">🏆 Keep it clean</h6>
                            <p class="mb-0 small text-muted">Edit or delete entries when needed.</p>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h4 class="card-title fw-bold text-center mb-3">Iconic Games Carousel</h4>

                <div class="container" style="max-width: 90%;">
                    <div id="iconicGamesCarousel" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner text-center">
                            <div class="carousel-item active">
                                <img src="~/img/CS.jpg" class="img-fluid" alt="Counter Strike"
                                     style="max-width: 18rem; height: auto; margin: auto;">
                                <p class="mt-3 mb-0 fw-bold">Counter-Strike</p>
                                <p class="small text-muted mb-0">Where reflexes become instinct.</p>
                            </div>

                            <div class="carousel-item">
                                <img src="~/img/MK.jpg" class="img-fluid" alt="Mortal Kombat"
                                     style="max-width: 18rem; height: auto; margin: auto;">
                                <p class="mt-3 mb-0 fw-bold">Mortal Kombat</p>
                                <p class="small text-muted mb-0">Finish the fight. Respect the classics.</p>
                            </div>

                            <div class="carousel-item">
                                <img src="~/img/MW.jpg" class="img-fluid" alt="Most Wanted"
                                     style="max-width: 18rem; height: auto; margin: auto;">
                                <p class="mt-3 mb-0 fw-bold">Need for Speed: Most Wanted</p>
                                <p class="small text-muted mb-0">Speed, style, and pure adrenaline.</p>
                            </div>
                        </div>

                        <button class="carousel-control-prev" type="button" data-bs-target="#iconicGamesCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>

                        <button class="carousel-control-next" type="button" data-bs-target="#iconicGamesCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <p class="mb-2 text-muted small">Pro tip: Add an image URL when you create a game for the best experience.</p>
                </div>
            </div>
        </div>
    </div>
</div>
