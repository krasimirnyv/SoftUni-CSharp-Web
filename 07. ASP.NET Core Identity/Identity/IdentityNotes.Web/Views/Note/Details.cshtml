@model DetailsNoteViewModel

<h2>Note Details</h2>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="d-flex align-items-start justify-content-between gap-3">
            <div class="w-100">
                <h4 class="card-title mb-2">@Model.Title</h4>
                
                <div class="text-muted small mb-3">
                    Created on: <span class="fw-semibold">@Model.CreatedOn</span>
                    <span class="mx-2">•</span>
                    Created by: <span class="fw-semibold">@Model.CreatedByEmail</span>
                </div>

                <div class="border rounded p-3 bg-light">
                    <p class="card-text mb-0" style="white-space: pre-wrap;">@Model.Content</p>
                </div>
            </div>
        </div>
    </div>
    
    <div class="card-footer bg-white">
        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="Note" asp-action="MyNotes" class="btn btn-secondary">Back</a>

            <a asp-controller="Note" asp-action="Edit" asp-route-noteId="@Model.Id" class="btn btn-warning">Edit</a>

            <a asp-controller="Note" asp-action="Delete" asp-route-noteId="@Model.Id" class="btn btn-danger">Delete</a>
        </div>
    </div>
</div>