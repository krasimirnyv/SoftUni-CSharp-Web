@model DeleteNoteViewModel

<h2>Delete Note</h2>

<form asp-controller="Note" asp-action="DeleteConfirmed" method="post">

    <input asp-for="Id" type="hidden" />

    <div class="alert alert-warning">
        Are you sure you want to delete this note?
    </div>


    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex align-items-start justify-content-between gap-3">
                <div class="w-100">
                    <h4 class="card-title mb-2">@Model.Title</h4>
                
                    <div class="text-muted small mb-3">
                        Created on: <span class="fw-semibold">@Model.CreatedOn</span>
                    </div>

                    <div class="border rounded p-3 bg-light">
                        <p class="card-text mb-0" style="white-space: pre-wrap;">@Model.Content</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-controller="Note" asp-action="MyNotes" class="btn btn-secondary">Cancel</a>
</form>
